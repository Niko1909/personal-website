---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/case-study.css";
import { Content, frontmatter } from "../../../content/case-studies/intracranial-hemorrhage-detection.md";

const title = `${frontmatter.title} · Nikolas Marinkovich`;
const description = frontmatter.subtitle;
---

<BaseLayout {title} {description}>
  <Header />
  <main id="top" tabindex="-1">
    <header class="case-hero container">
      <a class="back-link" href="/#work"><span aria-hidden="true">←</span> Selected work</a>
      <div class="case-hero-grid">
        <div>
          <p class="eyebrow">{frontmatter.project_type} · {frontmatter.date}</p>
          <h1>{frontmatter.title}</h1>
          <p class="case-subtitle">{frontmatter.subtitle}</p>
        </div>
        <dl class="case-meta">
          <div><dt>Institution</dt><dd>{frontmatter.institution}</dd></div>
          <div><dt>Partner</dt><dd>{frontmatter.partner}</dd></div>
          <div><dt>Team</dt><dd>{frontmatter.team_size} members</dd></div>
        </dl>
      </div>
      <ul class="tag-list" aria-label="Project technologies">
        {frontmatter.technologies.map((technology: string) => <li>{technology}</li>)}
      </ul>
      <dl class="case-summary">
        <div><dt>My contribution</dt><dd>{frontmatter.contribution}</dd></div>
        <div><dt>Outcome</dt><dd>{frontmatter.outcome}</dd></div>
      </dl>
    </header>
    <article class="case-body case-copy" aria-label="Intracranial Hemorrhage Detection case study">
      <Content />
    </article>
    <nav class="case-body case-nav" aria-label="Case study navigation">
      <a href="/#work"><span aria-hidden="true">←</span> Back to featured work</a>
      <a href="/work/distilling-chess-intelligence/">Explore the chess case study <span aria-hidden="true">→</span></a>
    </nav>
  </main>
  <Footer />
</BaseLayout>

<style>
  .case-copy { min-width: 0; }
  .case-copy :global(.metric-comparison) { margin: 28px 0; padding: 24px; background: var(--accent-soft); border-radius: var(--radius); }
  .case-copy :global(.metric-comparison figcaption) { font-size: 1.3rem; font-weight: 600; line-height: 1.35; }
  .case-copy :global(.metric-comparison .metric-note) { margin: 10px 0 0; font-size: .8rem; }
  .case-copy :global(.metric-comparison table) { table-layout: fixed; margin: 20px 0 0; background: var(--canvas); }
  .case-copy :global(.metric-comparison th) { font-size: .8rem; overflow-wrap: anywhere; }
  .case-copy :global(.metric-comparison td) { font-family: var(--font-mono); font-size: .86rem; }
  .case-copy :global(.metric-track) { display: block; height: 8px; margin-top: 10px; background: var(--border); border-radius: 4px; overflow: hidden; }
  .case-copy :global(.metric-track > span) { display: block; height: 100%; background: var(--accent); }
  .case-copy :global(table) { width: 100%; margin-block: 28px; border-collapse: collapse; font-size: .95rem; }
  .case-copy :global(th), .case-copy :global(td) { padding: 14px 16px; border: 1px solid var(--border); }
  .case-copy :global(th) { color: var(--ink); background: var(--accent-soft); }
  .case-copy :global(td:last-child) { font-family: var(--font-mono); font-size: .86rem; }
  @media (max-width: 520px) { .case-copy :global(th), .case-copy :global(td) { padding: 12px 8px; } .case-copy :global(.metric-comparison) { padding: 20px 12px; } .case-copy :global(.metric-comparison th[scope="col"]) { font-size: .72rem; } }
</style>
