---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ChessSignal from "../components/ChessSignal.astro";
import { Image } from "astro:assets";
import hemorrhageSlices from "../assets/hemorrhage-ct-slices.png";
import {
  profile,
  experience,
  productionWork,
  academicProjects,
  capabilities,
} from "../content/home";
---

<BaseLayout>
  <Header />
  <main id="top" tabindex="-1">
    <section class="hero container" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">Fullstack AI developer · Toronto</p>
        <h1 id="hero-title">Hey! I’m Nikolas.</h1>
        <p class="hero-intro">
          I build AI applications at <em>Intact’s Data Lab</em>, from their interfaces to the services behind them.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="#work">Explore my work <span aria-hidden="true">↘</span></a>
        </div>
        <div class="social-links" aria-label="Professional profiles">
          <a href={profile.github} target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
          <a href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
        </div>
      </div>

    </section>

    <section id="experience" class="section container" aria-labelledby="experience-title">
      <div class="simple-section-heading">
        <h2 id="experience-title" class="eyebrow">Experience</h2>
      </div>
      <div class="experience-list">
        {experience.map((item) => (
          <article class="experience-item">
            <div class="experience-meta">
              <p>{item.period}</p>
              <h3>{item.role}</h3>
              <p class="experience-company">
                <img class="company-logo" src={item.logo} alt="" width="64" height="40" loading="lazy" />
                <span>{item.organization}</span>
              </p>
            </div>
            <div>
              <p class="experience-summary">{item.summary}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="work" class="section work-section" aria-labelledby="work-title">
      <div class="container">
        <SectionHeading id="work-title" eyebrow="Selected work" title="Production engineering & applied research." />
        <article class="production-feature" aria-labelledby="production-title">
          <div class="production-heading">
            <p class="eyebrow light">Professional experience</p>
            <h3 id="production-title">{productionWork.title}</h3>
          </div>
          <ul class="production-contributions" aria-label="Contributions at Intact">
            {productionWork.contributions.map((contribution) => (
              <li><strong>{contribution.title}</strong><p>{contribution.description}</p></li>
            ))}
          </ul>
        </article>

        <div class="supporting-projects">
          {academicProjects.map((project, index) => (
            <article>
              <div class="project-number">0{index + 2}</div>
              <p class="project-period">{project.period}</p>
              <h3>{project.title}</h3>
              <p>{project.summary}</p>
              <ul class="tag-list" aria-label={`${project.title} technologies`}>
                {project.technologies.map((technology) => <li>{technology}</li>)}
              </ul>
              {project.kind === "chess" && <div class="academic-visual"><ChessSignal /></div>}
              {project.kind === "medical" && (
                <figure class="academic-visual medical-visual">
                  <Image src={hemorrhageSlices} width={960} format="webp" loading="lazy" alt="Eight grayscale axial CT slices arranged in two rows." />
                  <figcaption>Example CT slices · <a href="https://www.kaggle.com/datasets/vbookshelf/computed-tomography-ct-images" target="_blank" rel="noreferrer">Source: Kaggle</a></figcaption>
                </figure>
              )}
              <a class="project-link" href={project.href}>Read the case study<span class="sr-only">: {project.title}</span> <span aria-hidden="true">→</span></a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section container" aria-labelledby="profile-title">
      <div class="simple-section-heading">
        <h2 id="profile-title" class="eyebrow">Tools I work with</h2>
      </div>
      <div class="capability-grid">
        {capabilities.map((capability) => (
          <article>
            <h3>{capability.title}</h3>
            <ul>
              {capability.skills.map((skill) => <li>{skill}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section class="contact-section" aria-labelledby="contact-title">
      <div class="container contact-inner">
        <div>
          <p class="eyebrow">Let’s connect</p>
          <h2 id="contact-title">Get in touch.</h2>
        </div>
        <div>
          <p>For engineering opportunities or a conversation about my work:</p>
          <a class="contact-link" href={`mailto:${profile.email}`}>{profile.email} <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
