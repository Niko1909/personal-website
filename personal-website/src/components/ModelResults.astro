---
const results = [
  { family: "Linear", layers: "Baseline", value: 205.10, kind: "baseline" },
  { family: "Conv2D", layers: "0 hidden layers", value: 219.55, kind: "conv2d" },
  { family: "Conv2D", layers: "1 hidden layer", value: 232.96, kind: "conv2d" },
  { family: "Conv2D", layers: "2 hidden layers", value: 219.67, kind: "conv2d" },
  { family: "Conv2D", layers: "3 hidden layers", value: 215.06, kind: "conv2d" },
  { family: "Conv3D", layers: "0 hidden layers", value: 206.73, kind: "conv3d" },
  { family: "Conv3D", layers: "1 hidden layer", value: 210.03, kind: "conv3d" },
  { family: "Conv3D", layers: "2 hidden layers", value: 215.16, kind: "conv3d" },
  { family: "Conv3D", layers: "3 hidden layers", value: 209.60, kind: "conv3d" },
];
const position = (value: number) => `${((value - 200) / 35) * 100}%`;
---

<section class="results" aria-labelledby="results-title">
  <p class="eyebrow">Held-out performance</p>
  <h2 id="results-title">More capacity. No better generalization.</h2>
  <p class="results-intro">The convolutional students learned the training examples more closely, but none produced a lower held-out mean absolute error than the linear baseline.</p>

  <div class="finding" aria-label="Central result">
    <div><span>Central finding</span><strong>Zero of eight convolutional models beat the simplest model.</strong></div>
    <div><span>Best held-out MAE</span><strong>205.10</strong><small>centipawns · linear baseline</small></div>
  </div>

  <div class="chart-heading"><div><h3>Held-out mean absolute error by architecture</h3><p>Approximately 3,000 held-out positions · lower error is better</p></div><span>← Lower is better</span></div>
  <div class="chart-scroll">
    <div class="chart" role="img" tabindex="0" aria-label="Nine model architectures compared by held-out mean absolute error in centipawns. The linear baseline is best at 205.10 centipawns." aria-describedby="results-data">
      <div class="axis" aria-hidden="true"><span>Architecture</span><span class="axis-scale">{[200, 210, 220, 230, 235].map((value) => <span style={`left:${position(value)}`}>{value}</span>)}</span><span>MAE · cp</span></div>
      {results.map((result) => (
        <div class:list={["result-row", result.kind === "baseline" && "is-baseline"]}>
          <div class="model-name"><span>{result.family}</span><small>{result.layers}</small></div>
          <div class="track" aria-hidden="true"><span class="baseline-guide" style={`left:${position(results[0].value)}`}></span><span class:list={["dot", result.kind]} style={`--position:${position(result.value)}`}></span></div>
          <strong>{result.value.toFixed(2)}</strong>
        </div>
      ))}
      <div class="legend" aria-hidden="true"><span><i class="baseline"></i>Linear</span><span><i class="conv2d"></i>Conv2D</span><span><i class="conv3d"></i>Conv3D</span></div>
    </div>
  </div>
  <p class="sr-only" id="results-data">Linear baseline: 205.10 centipawns. Conv2D with zero, one, two, and three hidden layers: 219.55, 232.96, 219.67, and 215.06 centipawns. Conv3D with zero, one, two, and three hidden layers: 206.73, 210.03, 215.16, and 209.60 centipawns.</p>

  <div class="interpretation">
    <article><span>Training data</span><h3>Deeper models fit more closely.</h3><p>Training loss generally decreased as layers were added, indicating greater capacity to fit observed patterns.</p></article>
    <span aria-hidden="true">→</span>
    <article><span>Held-out positions</span><h3>The advantage disappeared.</h3><p>Held-out error fluctuated rather than improving with depth, exposing the experiment’s generalization gap.</p></article>
  </div>
  <p class="results-note">Metric: L1 loss, reported as mean absolute error in centipawns. Values are reproduced from the thesis results tables.</p>
</section>

<style>
  .results > h2 { max-width: 780px; margin: 0; font-size: clamp(2rem, 4vw, 3.4rem); font-weight: 500; line-height: 1.05; letter-spacing: -.05em; }
  .results-intro { max-width: 760px; margin: 16px 0 30px; color: var(--muted); }
  .finding { display: grid; grid-template-columns: 1.3fr .7fr; gap: 1px; overflow: hidden; color: white; background: var(--border); border-radius: 9px; }
  .finding > div { padding: 26px 28px; background: var(--code); }
  .finding span, .interpretation article > span { display: block; color: #b8d4dd; font-family: var(--font-mono); font-size: .68rem; letter-spacing: .1em; text-transform: uppercase; }
  .finding strong { display: block; margin-top: 7px; font-size: clamp(1.25rem, 2.5vw, 1.9rem); line-height: 1.2; }
  .finding > div:last-child strong { font-family: var(--font-mono); font-size: clamp(2.3rem, 5vw, 4rem); line-height: 1; }
  .finding small { display: block; margin-top: 8px; color: #dcecf1; }
  .chart-heading { margin: 38px 0 16px; display: flex; align-items: end; justify-content: space-between; gap: 24px; }
  .chart-heading h3 { margin: 0; font-size: 1.05rem; } .chart-heading p { margin: 4px 0 0; color: var(--muted); font-size: .8rem; } .chart-heading > span { color: var(--accent); font-family: var(--font-mono); font-size: .68rem; text-transform: uppercase; }
  .chart-scroll { overflow-x: auto; }
  .chart { min-width: 590px; padding: 22px 24px; background: var(--surface); border: 1px solid var(--border); border-radius: 9px; }
  .axis, .result-row { display: grid; grid-template-columns: 180px minmax(250px, 1fr) 76px; gap: 16px; align-items: center; }
  .axis { margin-bottom: 8px; color: var(--muted); font-family: var(--font-mono); font-size: .66rem; } .axis-scale { position: relative; height: 1.65em; } .axis-scale > span { position: absolute; transform: translateX(-50%); } .axis > span:last-child { text-align: right; }
  .result-row { min-height: 52px; border-top: 1px solid var(--border); }
  .result-row.is-baseline { margin: 0 -10px; padding: 0 10px; background: var(--accent-soft); border-top-color: transparent; border-radius: 6px; }
  .model-name { display: grid; grid-template-columns: 62px 1fr; align-items: center; gap: 8px; } .model-name span { font-size: .7rem; font-weight: 700; letter-spacing: .07em; text-transform: uppercase; } .model-name small { color: var(--muted); }
  .track { position: relative; height: 24px; } .track::before { content: ""; position: absolute; top: 11px; right: 0; left: 0; height: 2px; background: var(--border); }
  .baseline-guide { position: absolute; top: 0; bottom: 0; width: 1px; background: color-mix(in srgb, var(--accent) 42%, transparent); }
  .dot { position: absolute; top: 4px; left: var(--position); width: 16px; height: 16px; border: 3px solid var(--surface); border-radius: 50%; transform: translateX(-50%); box-shadow: 0 0 0 1px currentColor; } .dot.baseline { color: var(--ink); background: var(--ink); border-radius: 3px; transform: translateX(-50%) rotate(45deg); } .dot.conv2d { color: #9b654e; background: #9b654e; } .dot.conv3d { color: var(--accent); background: var(--accent); }
  .result-row > strong { text-align: right; font-family: var(--font-mono); font-size: .82rem; }
  .legend { margin-top: 16px; display: flex; gap: 18px; color: var(--muted); font-size: .75rem; } .legend span { display: flex; align-items: center; gap: 7px; } .legend i { width: 9px; height: 9px; border-radius: 50%; } .legend i.baseline { background: var(--ink); border-radius: 2px; transform: rotate(45deg); } .legend i.conv2d { background: #9b654e; } .legend i.conv3d { background: var(--accent); }
  .interpretation { margin-top: 30px; padding: 26px; display: grid; grid-template-columns: 1fr auto 1fr; gap: 22px; align-items: center; background: var(--accent-soft); border-radius: 9px; } .interpretation article > span { color: var(--accent); } .interpretation h3 { margin: 6px 0; font-size: 1.1rem; } .interpretation p { margin: 0; color: var(--muted); font-size: .86rem; } .interpretation > span { color: var(--accent); font-size: 1.7rem; }
  .results-note { margin: 22px 0 0; color: var(--muted); font-size: .75rem; }
  @media (max-width: 700px) { .finding, .interpretation { grid-template-columns: 1fr; } .interpretation > span { transform: rotate(90deg); justify-self: start; } .chart-heading { align-items: flex-start; flex-direction: column; } }
</style>
