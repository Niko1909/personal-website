---
import { profile } from "../content/home";

const home = Astro.url.pathname === "/" ? "" : "/";
---

<header class="site-header" data-site-header>
  <div class="container header-inner">
    <a class="wordmark" href={`${home}#top`} aria-label="Nikolas Marinkovich, home">
      <span class="wordmark-mark" aria-hidden="true">NM</span>
      <span>{profile.name}</span>
    </a>

    <nav id="site-nav" class="site-nav" aria-label="Primary navigation">
      <a href={`${home}#experience`}>Experience</a>
      <a href={`${home}#work`}>Work</a>
      <a href={`${home}#contact`}>Contact</a>
    </nav>

    <button class="menu-button" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="sr-only">Open navigation</span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const menuButton = header?.querySelector<HTMLButtonElement>(".menu-button");
  const nav = header?.querySelector<HTMLElement>(".site-nav");

  function closeMenu() {
    header?.removeAttribute("data-menu-open");
    menuButton?.setAttribute("aria-expanded", "false");
    menuButton?.querySelector(".sr-only")?.replaceChildren("Open navigation");
  }

  menuButton?.addEventListener("click", () => {
    const isOpen = menuButton.getAttribute("aria-expanded") === "true";
    menuButton.setAttribute("aria-expanded", String(!isOpen));
    header?.toggleAttribute("data-menu-open", !isOpen);
    menuButton.querySelector(".sr-only")?.replaceChildren(isOpen ? "Open navigation" : "Close navigation");
    if (!isOpen) nav?.querySelector<HTMLAnchorElement>("a")?.focus();
  });

  nav?.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMenu));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menuButton?.getAttribute("aria-expanded") === "true") {
      closeMenu();
      menuButton?.focus();
    }
  });
</script>
