---
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/jetbrains-mono/500.css";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "My Portfolio | Nikolas",
  description = "Fullstack AI developer at Intact building useful, reliable AI-powered products across interfaces, services, and cloud infrastructure.",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL("/og-v3.png", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c151b" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/portfolio-suitcase.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Nikolas Marinkovich" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:width" content="1733" />
    <meta property="og:image:height" content="908" />
    <meta property="og:image:alt" content="Nikolas Marinkovich, fullstack AI developer. Building intelligent products across the full stack." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta name="twitter:image:alt" content="Nikolas Marinkovich, fullstack AI developer. Building intelligent products across the full stack." />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#top">Skip to main content</a>
    <slot />
  </body>
</html>
